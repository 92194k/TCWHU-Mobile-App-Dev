<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base App Theme (No Action Bar) -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/deep_purple</item>
        <item name="colorOnPrimary">@color/pure_white</item>

        <!-- Background & Text -->
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar and Fullscreen -->
        <item name="android:statusBarColor">@color/deep_purple</item>
        <item name="android:windowFullscreen">true</item>

        <!-- Default Text/Window Colors -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- CRITICAL FIX: Add this new theme for the Image Cropper -->
    <!-- This theme HAS an action bar, which is required for the "Done" button -->
    <style name="AppTheme.ImageCropper" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/deep_purple</item>
        <item name="colorOnPrimary">@color/pure_white</item>
        <item name="android:statusBarColor">@color/deep_purple</item>
    </style>

    <!-- Fullscreen theme for viewing photos -->
    <style name="AppTheme.FullScreen" parent="AppTheme">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

</resources>