<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".PendingVerificationActivity">

    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:background="@drawable/bg_icon_pending_circle">
        <ImageView
            android:id="@+id/clockIcon" android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_clock"
            app:tint="#FF8F00" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Verification Pending"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your account is waiting for admin verification. This usually takes 24-48 hours."
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_checklist_box"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What happens next?"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="An admin will review your submitted photos"
            android:textColor="@color/text_secondary"
            app:drawableStartCompat="@drawable/ic_check_circle"
            app:drawableTint="#2E7D32"
            android:drawablePadding="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You'll receive an email notification when verified"
            android:textColor="@color/text_secondary"
            app:drawableStartCompat="@drawable/ic_check_circle"
            app:drawableTint="#2E7D32"
            android:drawablePadding="8dp"
            android:layout_marginTop="8dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Once approved, you can login and start connecting"
            android:textColor="@color/text_secondary"
            app:drawableStartCompat="@drawable/ic_check_circle"
            app:drawableTint="#2E7D32"
            android:drawablePadding="8dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonBackToHome"
        style="@style/PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Home"
        app:cornerRadius="28dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="Have questions or need help?\nReach out to our admin at alaokhemberly@gmail.com"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>