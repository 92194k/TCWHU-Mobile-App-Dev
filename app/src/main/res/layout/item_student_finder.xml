<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Avatar Section (mimics TSX gradient background) -->
        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="center">

            <TextView
                android:id="@+id/textAvatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:textColor="@color/pure_white"
                android:textSize="36sp"
                tools:text="😀" />
        </FrameLayout>

        <!-- Info Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textNickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="BlueDragon" />

            <TextView
                android:id="@+id/textYearLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="1st Year" />

            <!-- Interests Tags -->
            <LinearLayout
                android:id="@+id/interestsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:layout_marginBottom="10dp"
                tools:ignore="UnusedAttribute" />

            <!-- Start Chat Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonStartChat"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Start Chat"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/pure_white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>