<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp"
    android:paddingStart="80dp"
    android:paddingEnd="8dp"
    android:gravity="end">

    <LinearLayout
        android:id="@+id/bubbleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_message_sent"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:id="@+id/messageImage"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Sent image"/>

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/pure_white"
            android:textSize="15sp"
            tools:text="This is a sent message"/>

        <TextView
            android:id="@+id/textDeletedStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[This message was deleted]"
            android:textColor="@color/inactive_gray"
            android:textStyle="italic"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone"
            />
        <LinearLayout
            android:id="@+id/fileContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iconFile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_file_document"
                android:contentDescription="Document Icon"
                android:layout_marginEnd="8dp"
                app:tint="@color/pure_white" />

            <TextView
                android:id="@+id/textFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pure_white"
                android:text="document_name.pdf"
                android:maxLines="1"
                android:ellipsize="middle"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:id="@+id/iconFileDownload"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="4dp"
                android:src="@drawable/ic_download"
                android:contentDescription="Download File"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/pure_white"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/audioContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iconAudioPlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_play_arrow"
                android:contentDescription="Play Voice Message"
                android:background="@drawable/rounded_circle_background"
                android:tint="@color/deep_purple"
                android:clickable="true"
                android:focusable="true"/>

            <SeekBar
                android:id="@+id/audioSeekBar"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:thumbTint="@color/pure_white"
                android:progressTint="@color/pure_white"
                android:progressBackgroundTint="@color/inactive_gray"
                android:paddingVertical="10dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/textAudioDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pure_white"
                tools:text="0:25"/>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/bubbleLayout"
        android:layout_alignEnd="@id/bubbleLayout"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/textTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="10sp"
            tools:text="10:30 AM"/>

        <ImageView
            android:id="@+id/iconSeenStatus"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_check"
            android:visibility="visible"
            app:tint="@color/inactive_gray"
            tools:ignore="UseAppTint"
            android:contentDescription="Message status"/>
    </LinearLayout>
</RelativeLayout>