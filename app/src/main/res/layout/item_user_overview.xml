<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Avatar -->
        <TextView
            android:id="@+id/textAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="24sp"
            android:background="@drawable/bg_avatar_preview_circle"
            android:textColor="@color/pure_white"
            tools:text="😎"/>

        <!-- User Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/textNickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="BlueDragon"/>

            <TextView
                android:id="@+id/textStudentNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="2023-12345"/>

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#388E3C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                tools:text="VERIFIED"/>
        </LinearLayout>

        <!-- Buttons (Right Side) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSuspendAction"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="11sp"
                tools:text="SUSPEND"
                tools:icon="@drawable/ic_clock"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBanReviewAction"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:textSize="11sp"
                tools:text="BAN"
                app:icon="@drawable/ic_ban"/>

            <ImageButton
                android:id="@+id/buttonDelete"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete User"
                android:src="@drawable/ic_trash"
                app:tint="#B71C1C"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
