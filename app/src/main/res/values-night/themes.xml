<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ✅ Dark Mode Override -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/deep_purple</item>
        <item name="colorPrimaryVariant">@color/deep_purple_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- Dark Backgrounds -->
        <item name="android:windowBackground">@color/light_gray</item>
        <item name="android:textColorPrimary">@color/pure_white</item>

        <!-- Status & Navigation -->
        <item name="android:statusBarColor">@color/deep_purple_dark</item>
        <item name="android:navigationBarColor">@color/deep_purple_dark</item>
    </style>

</resources>
